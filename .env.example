# Copy to .env and fill in the credentials issued by Quran Foundation.
# Never commit the real .env file. These stay server-side.

# QF_ENV=prelive|production. Defaults to prelive if unset.
# prelive only includes Surahs 1-2.
# production requires Quran Foundation approval for all 114 surahs.
QF_ENV=prelive
QF_CLIENT_ID=
QF_CLIENT_SECRET=

# Optional local port. The app runs at http://localhost:3000 by default.
PORT=3000
